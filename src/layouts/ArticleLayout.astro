---
// Article page, from the article board: progress bar, header, cover, body, author card and
// "Keep reading". Mobile is not designed; it follows the landing mobile patterns.
import '../styles/prose.css';
import { getImage } from 'astro:assets';
import BaseLayout, { type OgImage } from './BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import PostCard from '../components/PostCard.astro';
import PostCover from '../components/PostCover.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Tag from '../components/Tag.astro';
import { coverOf, formatDate, getRelatedPosts, readingTime, type Post } from '../lib/content';
import { href } from '../lib/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, summary, tags, date } = post.data;
const minutes = readingTime(post.body);
const related = await getRelatedPosts(post);

// A cover photo doubles as the social preview, cropped to 1200×630. Generated art uses the default.
const cover = coverOf(post);
let ogImage: OgImage | undefined;
if (cover.kind === 'image') {
  const og = await getImage({ src: cover.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
  ogImage = { url: new URL(og.src, Astro.site).href, alt: cover.alt, width: 1200, height: 630 };
}
---

<BaseLayout title={title} description={summary} type="article" published={date} image={ogImage}>
  <ReadingProgress slot="top" target="#article" />

  <article id="article">
    <header class="container narrow head">
      <a class="back" href={href('/writing')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="M11 6l-6 6 6 6"></path>
        </svg>
        All posts
      </a>
      <div class="tags">{tags.map((tag) => <Tag tag={tag} />)}</div>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <div class="meta">
        <div class="avatar" aria-hidden="true">M</div>
        <div class="meta-text">
          <span class="author">Maurice</span>
          <span><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time> · {minutes} min read</span>
        </div>
      </div>
    </header>

    <div class="container cover-wrap">
      <div class="cover">
        <PostCover post={post} size="wide" sizes="(min-width: 1120px) 1040px, 100vw" />
      </div>
    </div>

    <div class="container text body">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>

  <div class="container text author-wrap">
    <AuthorCard />
  </div>

  {
    related.length > 0 && (
      <section class="band" aria-labelledby="related-title">
        <div class="container wide related">
          <h2 id="related-title">Keep reading</h2>
          <ul class="related-list" role="list">
            {related.map((other) => (
              <li>
                <PostCard post={other} variant="related" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Widths from the board: header 880, body 760, cover and related 1120 (padding included). */
  .narrow {
    max-width: calc(800px + 2 * var(--gutter));
  }

  .text {
    max-width: calc(680px + 2 * var(--gutter));
  }

  .wide,
  .cover-wrap {
    max-width: calc(1040px + 2 * var(--gutter));
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 16px;
  }

  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    font-weight: 700;
    font-size: 15px;
    color: var(--accent);
  }

  .back:hover {
    color: var(--text);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  h1 {
    font-size: clamp(36px, 5.5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .summary {
    font-size: 18px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding-top: 4px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--text);
  }

  .meta-text {
    display: flex;
    flex-direction: column;
  }

  .author {
    font-weight: 700;
    color: var(--text);
  }

  .cover-wrap {
    margin-top: 32px;
  }

  .cover {
    position: relative;
    height: 220px;
    overflow: hidden;
    border-radius: var(--radius-card-sm);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .body {
    padding-block: 40px 32px;
  }

  .author-wrap {
    padding-bottom: 56px;
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 48px;
  }

  .related h2 {
    font-size: clamp(26px, 3.5vw, 36px);
  }

  .related-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (min-width: 720px) {
    .head {
      gap: 24px;
      padding-top: 40px;
    }

    .summary {
      font-size: 21px;
    }

    .meta {
      padding-top: 8px;
    }

    .cover-wrap {
      margin-top: 48px;
    }

    .cover {
      height: 460px;
      border-radius: 28px;
    }

    .body {
      padding-block: 64px 40px;
    }

    .author-wrap {
      padding-bottom: 72px;
    }

    .related {
      gap: 32px;
      padding-block: 72px;
    }

    .related-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 24px;
    }

    .related-list > li {
      flex: 1 1 360px;
      min-width: 0;
    }
  }
</style>
