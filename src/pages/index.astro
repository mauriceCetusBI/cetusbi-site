---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Squiggle from '../components/Squiggle.astro';
import RideProfileAnimation from '../components/art/RideProfileAnimation.astro';
import { href } from '../lib/site';

const topics = [
  {
    title: 'Ride',
    short: 'Training, gear and events',
    text: 'Training, gear and events. What works on the road, and what the numbers say about it.',
    link: { label: 'Ride posts', path: '/#writing' },
    icon: 'ride',
  },
  {
    title: 'Data',
    short: 'Pipelines, dashboards, models',
    text: 'Pipelines, dashboards and semantic models. Practical data engineering, explained plainly.',
    link: { label: 'Data posts', path: '/#writing' },
    icon: 'data',
  },
  {
    title: 'Build',
    short: 'Apps, tools and build logs',
    text: 'Apps and tools that sit between the bike and the data. Build logs, code and lessons learned.',
    link: { label: 'Build logs', path: '/#projects' },
    icon: 'build',
  },
] as const;
---

<BaseLayout>
  <HeroSection wheel="landing">
    <div class="hero container">
      <div class="hero-copy">
        <span class="badge"><span class="dot" aria-hidden="true"></span>Cycling × Data</span>
        <h1>
          <span class="rise" style="--delay: 0.1s">Where cycling</span>
          <span class="rise" style="--delay: 0.3s">meets <Squiggle>data.</Squiggle></span>
        </h1>
        <p class="lead">
          I'm Maurice. I ride, I build data platforms for a living, and I write about what happens
          when the two collide<span class="lead-extra">: rides, dashboards, gear and the code behind it</span>.
        </p>
        <div class="actions">
          <a class="btn btn--primary" href={href('/#writing')}>
            Read the latest
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="btn" href={href('/#projects')}>See what I've built</a>
        </div>
        {import.meta.env.DEV && <a class="dev-link" href={href('/dev/content')}>Dev: content preview →</a>}
      </div>
      <div class="hero-visual">
        <RideProfileAnimation />
      </div>
    </div>
  </HeroSection>

  <section class="band" aria-labelledby="topics-title">
    <div class="container section topics">
      <SectionHeading id="topics-title" eyebrow="What I write about" title="Three things, one obsession." />
      <ul class="topic-list" role="list">
        {
          topics.map((topic) => (
            <li class="topic">
              <div class="topic-icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  {topic.icon === 'ride' && (
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <circle cx="12" cy="12" r="2.5" />
                      <line x1="12" y1="3" x2="12" y2="9.5" />
                      <line x1="12" y1="14.5" x2="12" y2="21" />
                      <line x1="3" y1="12" x2="9.5" y2="12" />
                      <line x1="14.5" y1="12" x2="21" y2="12" />
                    </>
                  )}
                  {topic.icon === 'data' && (
                    <>
                      <line x1="4" y1="20" x2="20" y2="20" />
                      <rect x="5" y="12" width="3.5" height="8" rx="1" />
                      <rect x="10.25" y="6" width="3.5" height="14" rx="1" />
                      <rect x="15.5" y="9" width="3.5" height="11" rx="1" />
                    </>
                  )}
                  {topic.icon === 'build' && (
                    <>
                      <polyline points="8,7 3,12 8,17" />
                      <polyline points="16,7 21,12 16,17" />
                      <line x1="14" y1="4.5" x2="10" y2="19.5" />
                    </>
                  )}
                </svg>
              </div>
              <div class="topic-body">
                <h3>{topic.title}</h3>
                <p class="topic-short">{topic.short}</p>
                <p class="topic-text">{topic.text}</p>
              </div>
              <a class="topic-link" href={href(topic.link.path)}>
                {topic.link.label} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px 56px;
    padding-block: 24px 48px;
  }

  .hero-copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* 480 px + the card's 2 × 24 px padding, which the design adds on top (content-box). */
  .hero-visual {
    flex: 1 1 528px;
    min-width: 0;
  }

  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yellow);
  }

  h1 {
    font-size: 40px;
    line-height: 1.02;
  }

  h1 > span {
    display: block;
  }

  .lead {
    max-width: 520px;
    font-size: 17px;
  }

  /* The mobile board uses a shorter intro. */
  .lead-extra {
    display: none;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dev-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 700;
    color: var(--yellow);
  }

  /* Topics */
  .topics {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: 48px;
  }

  .topic-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Mobile: the whole row is the link (the board shows compact rows). */
  .topic {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .topic-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--bg);
    color: var(--accent);
  }

  .topic-icon svg {
    width: 24px;
    height: 24px;
  }

  .topic-body {
    min-width: 0;
  }

  h3 {
    font-size: 18px;
  }

  .topic-short {
    font-size: 14px;
    color: var(--text-muted);
  }

  .topic-text {
    display: none;
  }

  .topic-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    font-size: 0;
    color: transparent;
  }

  @media (min-width: 720px) {
    .hero {
      gap: 56px;
      padding-block: 48px 112px;
    }

    .hero-copy {
      gap: 28px;
    }

    .badge {
      gap: 10px;
      padding: 8px 16px;
      font-size: var(--fs-eyebrow);
    }

    .dot {
      width: 8px;
      height: 8px;
    }

    h1 {
      font-size: var(--fs-h1);
      line-height: 1;
    }

    .lead {
      font-size: var(--fs-lead);
    }

    .lead-extra {
      display: inline;
    }

    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 14px;
    }

    .topics {
      gap: 40px;
      padding-block: 88px;
    }

    .topic {
      min-width: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 28px;
      border-radius: var(--radius-card-sm);
    }

    .topic-icon {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-inner);
    }

    .topic-icon svg {
      width: 26px;
      height: 26px;
    }

    .topic-body {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    h3 {
      font-size: 22px;
    }

    .topic-short {
      display: none;
    }

    .topic-text {
      display: block;
      font-size: 16px;
      color: var(--text-muted);
    }

    .topic-link {
      position: static;
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      min-height: var(--tap);
      font-size: inherit;
      font-weight: 700;
      color: var(--accent);
    }
  }

  /* Tablet keeps the cards stacked (no board; a 2 + 1 wrap looked broken). */
  @media (min-width: 1024px) {
    .topic-list {
      flex-direction: row;
    }

    .topic {
      flex: 1 1 0;
    }
  }
</style>
