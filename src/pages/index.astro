---
// Placeholder landing: hero copy only. The full landing (animation, writing, projects) is a later step.
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
---

<BaseLayout>
  <section class="hero container">
    <span class="badge"><span class="dot" aria-hidden="true"></span>Cycling × Data</span>
    <h1>Where cycling<br />meets <span class="accent">data.</span></h1>
    <p class="lead">
      I'm Maurice. I ride, I build data platforms for a living, and I write about what happens when
      the two collide: rides, dashboards, gear and the code behind it.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={href('/writing')}>
        Read the latest
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a class="btn" href={href('/#projects')}>See what I've built</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-block: 24px 48px;
  }

  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yellow);
  }

  h1 {
    font-size: 40px;
    line-height: 1.02;
  }

  .accent {
    color: var(--accent);
  }

  .lead {
    max-width: 520px;
    font-size: 17px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 720px) {
    .hero {
      gap: 28px;
      padding-block: 48px 112px;
    }

    .badge {
      gap: 10px;
      padding: 8px 16px;
      font-size: var(--fs-eyebrow);
    }

    .dot {
      width: 8px;
      height: 8px;
    }

    h1 {
      font-size: var(--fs-h1);
      line-height: 1;
    }

    .lead {
      font-size: var(--fs-lead);
    }

    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 14px;
    }
  }
</style>
