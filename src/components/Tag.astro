---
// Topic pill shown above an article title.
import { TAG_LABELS, type Tag } from '../lib/content';

interface Props {
  tag: Tag;
}

const { tag } = Astro.props;
---

<span class="tag">{TAG_LABELS[tag]}</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
