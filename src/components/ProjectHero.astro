---
// Top of a project page: breadcrumb, tags badge, title with squiggle, summary, buttons, phone,
// and the facts bar (role, stack, status, started).
import HeroSection from './HeroSection.astro';
import PhonePlaceholder from './PhonePlaceholder.astro';
import Squiggle from './Squiggle.astro';
import Sticker from './Sticker.astro';
import ProjectArt from './art/ProjectArt.astro';
import { postPath, type Post, type Project } from '../lib/content';
import { href } from '../lib/site';

interface Props {
  project: Project;
  /** Post linked as "Read the build log", if there is one. */
  buildLog?: Post;
}

const { project, buildLog } = Astro.props;
const { title, titleAccent, summary, tags, role, stack, status, started, art, sticker, link, heroImage } = project.data;

// Split the title around the accented part (default: the last word).
const accent = titleAccent && title.includes(titleAccent) ? titleAccent : title.split(' ').at(-1)!;
const at = title.lastIndexOf(accent);
const before = title.slice(0, at);
const after = title.slice(at + accent.length);

const facts = [
  { label: 'Role', value: role },
  { label: 'Stack', value: stack.join(' · ') },
  { label: 'Status', value: status },
  { label: 'Started', value: String(started) },
];
---

<HeroSection>
  <div class="container hero">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href={href('/#projects')}>Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <div class="main">
      <div class="copy">
        <span class="badge"><span class="dot" aria-hidden="true"></span>{tags.join(' · ')}</span>
        <h1><span class="rise" style="--delay: 0.1s">{before}<Squiggle>{accent}</Squiggle>{after}</span></h1>
        <p class="lead rise" style="--delay: 0.4s">{summary}</p>
        {
          (link || buildLog) && (
            <div class="actions rise" style="--delay: 0.6s">
              {link && (
                <a class="btn btn--primary" href={link.url}>
                  {link.label}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7" />
                    <path d="M8 7h9v9" />
                  </svg>
                </a>
              )}
              {buildLog && <a class="btn" href={href(postPath(buildLog))}>Read the build log</a>}
            </div>
          )
        }
      </div>

      <div class="visual">
        {sticker && <Sticker>{sticker}</Sticker>}
        <PhonePlaceholder size="hero" image={heroImage?.image} alt={heroImage?.alt}>
          <p class="phone-title">{title}</p>
          {art && <ProjectArt variant={art} />}
        </PhonePlaceholder>
      </div>
    </div>

    <dl class="facts">
      {
        facts.map((fact) => (
          <div class="fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</HeroSection>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 8px 56px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .crumbs [aria-current] {
    color: var(--text);
  }

  .main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 40px 56px;
  }

  .copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yellow);
  }

  h1 {
    font-size: clamp(46px, 7vw, 92px);
    overflow-wrap: anywhere;
  }

  h1 > span {
    display: block;
  }

  .lead {
    max-width: 520px;
    font-size: 18px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .visual {
    position: relative;
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .visual > :global(.sticker) {
    right: 4%;
    top: -14px;
  }

  .phone-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 20px;
  }

  .facts {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card-sm);
  }

  /* Hairlines between facts, also when they wrap: each fact draws a left and top border and
     the container hides the outer ones. */
  /* Two per row on phones, four across on desktop. */
  .fact {
    flex: 1 1 140px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: -1px 0 0 -1px;
    padding: 20px 24px;
    border-left: 1px solid var(--border);
    border-top: 1px solid var(--border);
  }

  dt {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 19px;
  }

  @media (min-width: 720px) {
    .hero {
      gap: 48px;
      padding-block: 16px 96px;
    }

    .copy {
      gap: 26px;
    }

    .badge {
      gap: 10px;
      padding: 8px 16px;
      font-size: var(--fs-eyebrow);
    }

    .dot {
      width: 8px;
      height: 8px;
    }

    .lead {
      font-size: 20px;
    }

    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 14px;
    }
  }
</style>
