---
// The newest post, large. "stacked" (landing): cover on top, text below.
// "split" (Writing overview): cover left, text right, with date and reading time.
import PostCover from './PostCover.astro';
import { formatDate, isNew, postPath, readingTime, tagLabel, type Post } from '../lib/content';
import { href } from '../lib/site';

interface Props {
  post: Post;
  layout?: 'stacked' | 'split';
  headingLevel?: 'h2' | 'h3';
}

const { post, layout = 'stacked', headingLevel: Heading = 'h3' } = Astro.props;
const split = layout === 'split';
---

<a class:list={['card', 'featured', layout]} href={href(postPath(post))} data-tags={post.data.tags.join(' ')}>
  <div class="cover">
    <PostCover post={post} size="wide" sizes={split ? '(min-width: 1200px) 620px, 100vw' : '(min-width: 1200px) 640px, 100vw'} />
    {isNew(post) && <span class="new">New</span>}
  </div>
  <div class="body">
    <span class="tags">{tagLabel(post.data.tags)}</span>
    <Heading class="title">{post.data.title}</Heading>
    <p class="summary">{post.data.summary}</p>
    {split && <span class="meta">{formatDate(post.data.date)} · {readingTime(post.body)} min read</span>}
    <span class="read">Read post →</span>
  </div>
</a>

<style>
  .featured {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card-sm);
  }

  .cover {
    position: relative;
    height: 190px;
    background: var(--bg);
  }

  .new {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: var(--yellow);
    color: var(--on-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
  }

  .tags {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .title {
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .summary {
    font-size: 15px;
    color: var(--text-muted);
  }

  .meta {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .read {
    display: none;
  }

  @media (min-width: 720px) {
    .featured {
      border-radius: var(--radius-card);
    }

    .cover {
      height: 300px;
    }

    .new {
      left: 20px;
      top: 20px;
      padding: 6px 12px;
      font-size: 12px;
    }

    .body {
      gap: 12px;
      padding: 28px;
    }

    .title {
      font-size: 28px;
    }

    .summary {
      font-size: 16px;
    }

    .read {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      font-weight: 700;
      color: var(--accent);
    }

    /* Split: cover and text side by side, wrapping to stacked when narrow (as on the board). */
    .split {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .split .cover {
      flex: 1.2 1 480px;
      height: auto;
      min-height: 320px;
    }

    /* 380 px + 2 × 40 px padding (content-box on the board). */
    .split .body {
      flex: 1 1 460px;
      justify-content: center;
      gap: 14px;
      padding: 40px;
    }

    .split .title {
      font-size: clamp(26px, 3vw, 36px);
    }

    .split .summary {
      font-size: 17px;
    }
  }
</style>
