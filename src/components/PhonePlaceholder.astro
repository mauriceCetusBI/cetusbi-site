---
// Phone frame from the project board. Shows a screenshot when given one, else the slot content.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** hero: large frame next to the project title; screen: smaller frame in the "Screens" row. */
  size?: 'hero' | 'screen';
  image?: ImageMetadata;
  alt?: string;
}

const { size = 'screen', image, alt = '' } = Astro.props;
---

<div class:list={['phone', size]}>
  <div class="notch" aria-hidden="true"></div>
  {
    image ? (
      <Image class="shot" src={image} alt={alt} widths={[300, 450, 600]} sizes="(min-width: 720px) 300px, 80vw" />
    ) : (
      <div class="content">
        <slot />
      </div>
    )
  }
</div>

<style>
  .phone {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    overflow: hidden;
    border-radius: 32px;
    border: 2px solid var(--border);
    background: var(--surface);
    aspect-ratio: 9 / 15;
  }

  .hero {
    width: min(100%, 340px);
    gap: 16px;
    padding: 18px;
    border-radius: 36px;
    aspect-ratio: 9 / 14;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }

  .notch {
    flex: none;
    align-self: center;
    width: 40%;
    height: 6px;
    border-radius: 3px;
    background: var(--border);
  }

  .hero .notch {
    width: 36%;
  }

  .content {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shot {
    flex: 1;
    min-height: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 20px;
  }
</style>
