---
// Tilted yellow label. Position it from the parent via the `class` prop.
interface Props {
  class?: string;
  /** Seconds before it pops in. Omit for a static sticker. */
  delay?: number;
}

const { class: className, delay } = Astro.props;
const animated = delay !== undefined;
---

<div
  class:list={['sticker', className, { animated }]}
  style={animated ? `--sticker-delay: ${delay}s` : undefined}
>
  <slot />
</div>

<style>
  .sticker {
    position: absolute;
    z-index: 3;
    transform: rotate(-6deg);
    padding: 7px 12px;
    border-radius: 10px;
    background: var(--yellow);
    color: var(--on-accent);
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.02em;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
  }

  .animated {
    animation: sticker 0.6s cubic-bezier(0.3, 1.5, 0.5, 1) var(--sticker-delay) both;
  }

  @media (min-width: 720px) {
    .sticker {
      padding: 10px 16px;
      border-radius: 12px;
      font-size: 14px;
      box-shadow: var(--shadow-sticker);
    }
  }
</style>
