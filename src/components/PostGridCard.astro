---
// Post card for the Writing overview grid: cover art on top, tag, title, summary, date.
import PostCover from './PostCover.astro';
import { formatDate, postPath, readingTime, tagLabel, type Post } from '../lib/content';
import { href } from '../lib/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a class="card grid-card" href={href(postPath(post))} data-tags={post.data.tags.join(' ')}>
  <div class="cover">
    <PostCover post={post} size="card" sizes="(min-width: 1200px) 360px, (min-width: 720px) 50vw, 100vw" />
  </div>
  <div class="body">
    <span class="tags">{tagLabel(post.data.tags)}</span>
    <h3>{post.data.title}</h3>
    <p class="summary">{post.data.summary}</p>
    <span class="meta">{formatDate(post.data.date)} · {readingTime(post.body)} min read</span>
  </div>
</a>

<style>
  .grid-card {
    height: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-card-sm);
  }

  .cover {
    height: 180px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 24px;
  }

  .tags {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 {
    font-size: 21px;
    line-height: 1.25;
  }

  .summary {
    font-size: 15px;
    color: var(--text-muted);
  }

  .meta {
    margin-top: auto;
    padding-top: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
  }
</style>
