---
// Accent-colored word with a hand-drawn yellow underline that draws itself in.
interface Props {
  /** Seconds before the underline starts drawing. */
  delay?: number;
}

const { delay = 0.9 } = Astro.props;
---

<span class="squiggle" style={`--squiggle-delay: ${delay}s`}><slot /><svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 8 C 22 0, 38 14, 58 7 S 94 1, 114 8 S 150 14, 170 7 S 190 3, 198 7" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-dasharray="1"></path></svg></span>

<style>
  .squiggle {
    position: relative;
    display: inline-block;
    color: var(--accent);
  }

  svg {
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 10px;
    max-width: none;
    overflow: visible;
    color: var(--yellow);
  }

  path {
    animation: draw 0.9s ease-out var(--squiggle-delay) both;
  }

  @media (min-width: 720px) {
    svg {
      bottom: -8px;
      height: 12px;
    }
  }
</style>
