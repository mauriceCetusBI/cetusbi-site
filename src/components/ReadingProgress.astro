---
// Thin mint bar at the very top that fills while the article is read. Decorative: the
// scroll position already tells assistive tech where the reader is.
interface Props {
  /** CSS selector of the element whose reading progress is shown. */
  target: string;
}

const { target } = Astro.props;
---

<div class="progress" aria-hidden="true">
  <div class="bar" data-reading-progress={target}></div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = bar && document.querySelector<HTMLElement>(bar.dataset.readingProgress!);

  if (bar && article) {
    let queued = false;
    const update = () => {
      queued = false;
      const { top, height } = article.getBoundingClientRect();
      const readable = height - window.innerHeight;
      const progress = readable > 0 ? Math.min(1, Math.max(0, -top / readable)) : 1;
      bar.style.transform = `scaleX(${progress})`;
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
  }
</script>

<style>
  /* In the page flow it takes the 4 px the board gives it; the bar itself stays pinned on scroll. */
  .progress {
    height: 4px;
    background: var(--surface);
  }

  .bar {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
</style>
