---
// One step of "How it works": icon, big step number, title, text.
import type { STEP_ICONS } from '../content.config';

interface Props {
  number: number;
  title: string;
  text: string;
  icon?: (typeof STEP_ICONS)[number];
}

const { number, title, text, icon } = Astro.props;
---

<div class="step">
  <div class="top">
    {
      icon && (
        <div class="icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {icon === 'route' && (
              <>
                <circle cx="6" cy="18" r="2.5" />
                <circle cx="18" cy="6" r="2.5" />
                <path d="M8.5 18H14a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h5.5" />
              </>
            )}
            {icon === 'clock' && (
              <>
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" />
              </>
            )}
            {icon === 'bell' && (
              <>
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                <path d="M10 21a2 2 0 0 0 4 0" />
              </>
            )}
            {icon === 'chart' && (
              <>
                <line x1="4" y1="20" x2="20" y2="20" />
                <rect x="5" y="12" width="3.5" height="8" rx="1" />
                <rect x="10.25" y="6" width="3.5" height="14" rx="1" />
                <rect x="15.5" y="9" width="3.5" height="11" rx="1" />
              </>
            )}
            {icon === 'code' && (
              <>
                <polyline points="8,7 3,12 8,17" />
                <polyline points="16,7 21,12 16,17" />
                <line x1="14" y1="4.5" x2="10" y2="19.5" />
              </>
            )}
            {icon === 'bike' && (
              <>
                <circle cx="6" cy="16" r="3.5" />
                <circle cx="18" cy="16" r="3.5" />
                <path d="M6 16l4-8h5l3 8" />
                <path d="M10 8L9 6H7" />
              </>
            )}
          </svg>
        </div>
      )
    }
    <span class="number" aria-hidden="true" data-number={String(number).padStart(2, '0')}></span>
  </div>
  <h3>{title}</h3>
  <p>{text}</p>
</div>

<style>
  .step {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-card-sm);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-inner);
    background: var(--bg);
    color: var(--accent);
  }

  /* Decorative step number, drawn as generated content: the order is already given by the
     list, and the faint design color is not meant to be read. */
  .number::before {
    content: attr(data-number);
  }

  .number {
    margin-left: auto;
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 40px;
    line-height: 1;
    color: var(--track);
  }

  h3 {
    font-size: 21px;
  }

  p {
    font-size: 16px;
    color: var(--text-muted);
  }

  @media (min-width: 720px) {
    .step {
      padding: 28px;
    }
  }
</style>
