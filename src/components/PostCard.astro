---
// Compact post card: small cover tile on the left, tag and title on the right.
// Used next to the featured post on the landing page.
import PostCover from './PostCover.astro';
import { postPath, tagLabel, type Post } from '../lib/content';
import { href } from '../lib/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a class:list={['card', 'compact']} href={href(postPath(post))}>
  <div class="thumb">
    <div class="thumb-art"><PostCover post={post} size="thumb" sizes="132px" /></div>
  </div>
  <div class="body">
    <span class="tags">{tagLabel(post.data.tags)}</span>
    <h3>{post.data.title}</h3>
  </div>
</a>

<style>
  .compact {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    border-radius: 16px;
  }

  .thumb {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg);
  }

  .thumb-art {
    width: 48px;
    height: 48px;
  }

  /* A photo fills the whole tile instead of sitting in the middle like the art. */
  .thumb-art:has(img) {
    width: 100%;
    height: 100%;
  }

  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tags {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 {
    font-size: 16px;
    line-height: 1.25;
  }

  @media (min-width: 720px) {
    .compact {
      flex-wrap: wrap;
      align-items: stretch;
      gap: 0;
      padding: 0;
      overflow: hidden;
      border-radius: var(--radius-card-sm);
    }

    .thumb {
      flex: 0 0 132px;
      width: auto;
      height: auto;
      min-height: 132px;
      border-radius: 0;
    }

    .thumb-art {
      width: 84px;
      height: 84px;
    }

    .body {
      flex: 1 1 180px;
      gap: 8px;
      padding: 20px;
    }

    .tags {
      font-size: 12px;
    }

    h3 {
      font-size: 19px;
    }
  }
</style>
