---
// The spoke-wheel mark: white ring with a green arc. Decorative, the wordmark carries the name.
interface Props {
  size?: number;
}

const { size = 34 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 34 34" fill="none" aria-hidden="true">
  <circle cx="17" cy="17" r="12" stroke="#F8F8FF" stroke-width="4"></circle>
  <path d="M17 3 A14 14 0 0 1 31 17" stroke="#4CB97A" stroke-width="5" stroke-linecap="round"></path>
</svg>
